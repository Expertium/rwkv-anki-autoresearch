@echo off
REM ENDGAME ARM 2, PHASE C ONLY -- the QUANT-AWARE rectified VAL-half eval, WITH THE LEARNED CATALOGS.
REM Generated by scratchpad/w10qat/mk_w10qat_eval.py from run_w10qat.cmd; the env is copied verbatim.
REM
REM WHY THIS EXISTS. run_w10qat.cmd trains both catalogs and its phase C would then have evaluated
REM with the env it trained with, i.e. the START catalogs reference/pq_cb_*_ws10_*.txt. The learned
REM ones exist only as scratchpad/ws10/w10q_d_{wkv,shift}cb_21870.txt, and nothing loads them back.
REM By step 4000 they had moved 43 percent (WKV) and 45 percent (shift) from the start. The recorded
REM tax (qtaxd_cblearn) was measured WITH the learned catalogs -- run_cblearn.cmd re-points the env
REM before its eval -- and this runner does exactly what that one did.
REM
REM run_w10qat.cmd's cmd was stopped on 2026-09-10 during the decay; its decay python kept running.
REM wait_decay_then_qateval.cmd calls this runner once that python has exited and all three step-21870
REM artifacts exist. Fresh log: w10qat_eval.log. w10qat.log carries no terminal marker.
REM
REM ANDREW 2026-09-10: "Every run with QAT should be evaluated with quantization on." Quantized is
REM not enough -- it must quantize with the catalog that SHIPS -- so the probe guards the loaded PATH.
setlocal
cd /d C:\Users\Andrew\rwkv-anki-autoresearch
REM ---- PHASE L: the query-row clock-leak counterfactual on ARM 1 (scratchpad/leak/PREREG.md) ----
REM First, before arm 2's env exists: three plain evals of w10p_d_21870 on 300 users, ~1 h. It
REM sets and clears its own env under setlocal, logs to scratchpad/leak/leak_cf.log, always returns.
call scratchpad\leak\run_leak_cf.cmd
set DIR=C:\Users\Andrew\rwkv-anki-autoresearch\scratchpad\w10qat
set SRC=C:\Users\Andrew\rwkv-anki-autoresearch\scratchpad\ws10
set LOG=%DIR%\w10qat_eval.log
set STAMP=%RANDOM%%RANDOM%
set TAG=w10qat
set STEPS=21870
set DECAYLOG=%DIR%\decay_2095110864.log

set PYTHONUNBUFFERED=1
set PYTHONPATH=C:\Users\Andrew\rwkv-anki-autoresearch
set OMP_NUM_THREADS=7
set RWKV_DETERMINISTIC=1
set RWKV_AUGMENT_SEED=4321
set RWKV_EMPTY_CACHE_EVERY=1
set RWKV_EMPTY_CACHE_WINDOW=0
REM The decay saves a checkpoint only on a validate step, and write_decay_setup hardcoded
REM 100000 -- so a 21,870-step decay checkpointed at step 50 and at the END and nowhere else.
REM A PC restart already killed one decay at 10,681/10,935. 2000 gives ~11 resume points for
REM ~4 percent of the phase, and it is trajectory-FREE: validation runs under model.eval()
REM inside no_grad and draws no main-process RNG (proven with a non-vacuity control by
REM scratchpad/ws10/rng_neutrality.py). Every endgame branch sets the SAME value, so they
REM stay mutually comparable.
set RWKV_DECAY_VALIDATE_EVERY=2000
set RWKV_ARCH_MODULE=scratchpad/track2_a18/architecture_d80_lora4_cnd.py
set RWKV_INTERLEAVE=1
set RWKV_GRU_HEAD=3
set RWKV_PAVA_LAMBDA=0.2
set RWKV_PROBE_DENSITY=0.08
set RWKV_PROBE_DUR=0.0
set RWKV_MUON=1
set RWKV_MUON_LR=0.0025
set RWKV_MUON_MOMENTUM=0.95
set RWKV_MUON_INCLUDE_LORA=1
set RWKV_NO_AHEAD_RESIDUAL=1
set RWKV_STRIP_L0_VLORA=1
set RWKV_STATE_CLAMP_TAU=300
set RWKV_STATE_CLAMP_WINDOW=32768
set RWKV_STRIP_CMIX=user_id:0,user_id:1,user_id:2,preset_id:0,preset_id:1,preset_id:2,deck_id:1,deck_id:2,card_id:1
set RWKV_WEIGHT_DECAY=0.01
set RWKV_WEIGHT_DECAY_HEAD=0.01
set RWKV_CLIP=0.25
set RWKV_ADAMW_BETA2=0.999
set RWKV_DROPOUT_SCALE=0.5
set RWKV_MUON_BATCHED=1
set RWKV_NO_JIT=1
set RWKV_QAT_COMPILE=1

REM ---- what distinguishes this arm: the -id layout AND the real-time cycles ----
set RWKV_ID_FEATURES=1
set RWKV_REAL_CYCLES=1
set RWKV_ZERO_FEATURES=
REM db overrides consumed by write_decay_setup.py / write_eval_toml.py, which used to
REM hardcode the 92-dim paths -- the trap the idfeat diagnostic caught.
set RWKV_VAL_DB=F:/rwkv_lmdb/test_db_5k_id5
set RWKV_EVAL_DB=F:/rwkv_lmdb/test_db_5k_id5
set RWKV_LABEL_FILTER_DB=F:/rwkv_lmdb/label_filter_db_id_e2s
REM KD explicitly CLEARED, never merely unset, so an inherited value cannot turn the
REM control into a treatment -- the false-green shape that bit the rgate smoke.
set RWKV_KD_MIX=
set RWKV_KD_ALPHA=



REM ---- QAT: the ONLY difference from arm 1. Decay-only and warm-started, which is how QAT is
REM deployed here and what iter 40 (+0.0118 from scratch) says it must be.
set RWKV_QAT_LOWRANK_SCOPE=card:1:int4,note:1:int4
set RWKV_QAT_PQ=reference/pq_cb_wkv_ws10_b10.txt
set RWKV_QAT_SHIFT_PQ=reference/pq_cb_shift_ws10_m2b12.txt
set RWKV_QAT_SHIFT_SCOPE=card:int3,note:int3
set RWKV_QAT_NORM_BITS=1
set RWKV_QAT_FUSED=1
set RWKV_QAT_PQ_LEARN=1
set RWKV_QAT_SHIFT_PQ_LEARN=1

echo ===== w10qat EVAL START %DATE% %TIME% ===== > "%LOG%"

REM ---- PHASE 0: the decay artifacts, tested WHERE A DECAY-ONLY RUN WRITES THEM (the SOURCE folder) ----
if not exist "%SRC%\w10q_d_%STEPS%.pth" (
  echo %TAG% NO_DECAY_CKPT %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_60 %DATE% %TIME% >> "%LOG%"
  exit /b 60
)
if not exist "%SRC%\w10q_d_wkvcb_%STEPS%.txt" (
  echo %TAG% NO_LEARNED_WKV_CATALOG %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_61 %DATE% %TIME% >> "%LOG%"
  exit /b 61
)
if not exist "%SRC%\w10q_d_shiftcb_%STEPS%.txt" (
  echo %TAG% NO_LEARNED_SHIFT_CATALOG %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_62 %DATE% %TIME% >> "%LOG%"
  exit /b 62
)

REM ---- PHASE 0b: the decay that produced them. The stopped runner would have checked KD here. ----
findstr /C:"[kd-mix] KD ON" "%DECAYLOG%" >nul
if not errorlevel 1 (
  echo %TAG% KD_WAS_ON_IN_THE_DECAY %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_63 %DATE% %TIME% >> "%LOG%"
  exit /b 63
)
findstr /C:"[wkv-pq] codebook LEARNABLE" "%DECAYLOG%" >nul
if errorlevel 1 (
  echo %TAG% WKV_CATALOG_WAS_NOT_LEARNABLE %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_64 %DATE% %TIME% >> "%LOG%"
  exit /b 64
)
findstr /C:"[shift-pq] codebook LEARNABLE" "%DECAYLOG%" >nul
if errorlevel 1 (
  echo %TAG% SHIFT_CATALOG_WAS_NOT_LEARNABLE %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_65 %DATE% %TIME% >> "%LOG%"
  exit /b 65
)
REM A HOLLOW decay swallows every step's exception and still exits 0 -- the first arm-2 launch.
findstr /C:"Traceback" /C:"InductorError" "%DECAYLOG%" >nul
if not errorlevel 1 (
  echo %TAG% DECAY_LOG_HAS_A_TRACEBACK %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_66 %DATE% %TIME% >> "%LOG%"
  exit /b 66
)
echo %TAG% DECAY_VERIFIED %TIME% >> "%LOG%"

REM ---- EVAL ENV: the LEARNED catalogs, learning OFF -- run_cblearn.cmd's recipe, verbatim ----
set RWKV_QAT_PQ=scratchpad/ws10/w10q_d_wkvcb_%STEPS%.txt
set RWKV_QAT_SHIFT_PQ=scratchpad/ws10/w10q_d_shiftcb_%STEPS%.txt
set RWKV_QAT_PQ_LEARN=
set RWKV_QAT_SHIFT_PQ_LEARN=
set RWKV_EVAL_PAVA=1

REM Quantization must be ON in the CONSUMED config (the 2026-08-12 inert-env class). Seconds.
.venv\Scripts\python.exe scratchpad/qat_tax/assert_qat_live.py >> "%LOG%" 2>&1
if not %ERRORLEVEL%==0 (
  echo %TAG% EVAL_WOULD_NOT_BE_QUANT_AWARE %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_67 %DATE% %TIME% >> "%LOG%"
  exit /b 67
)

REM ---- PHASE P: 10-user PROBE, minutes. It must LOAD the learned catalogs, with learning off, and
REM give a sane cost against arm 1 -- all proven before ~10 h of GPU is spent on the full eval. ----
if exist "result\RWKV-%TAG%p.jsonl" del /q "result\RWKV-%TAG%p.jsonl"
if exist "result\RWKV-P-%TAG%p.jsonl" del /q "result\RWKV-P-%TAG%p.jsonl"
.venv\Scripts\python.exe scratchpad/write_eval_toml.py scratchpad/w10qat w10q_d %DIR%\probe.toml RWKV-%TAG%p RWKV-P-%TAG%p 5001 5010 > "%DIR%\ptoml_%STAMP%.log" 2>&1
if not %ERRORLEVEL%==0 (
  echo %TAG% PROBE_TOML_FAILED %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_68 %DATE% %TIME% >> "%LOG%"
  exit /b 68
)
findstr /C:"w10q_d_%STEPS%.pth" "%DIR%\probe.toml" >nul
if errorlevel 1 (
  echo %TAG% PROBE_TOML_WRONG_CHECKPOINT %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_69 %DATE% %TIME% >> "%LOG%"
  exit /b 69
)
findstr /C:"F:/rwkv_lmdb/test_db_5k_id5" "%DIR%\probe.toml" >nul
if errorlevel 1 (
  echo %TAG% PROBE_DB_MISMATCH %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_70 %DATE% %TIME% >> "%LOG%"
  exit /b 70
)
.venv\Scripts\python.exe -u -m rwkv.get_result --config %DIR%\probe.toml > "%DIR%\probe_%STAMP%.log" 2>&1
if not %ERRORLEVEL%==0 (
  echo %TAG% PROBE_EVAL_FAILED %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_71 %DATE% %TIME% >> "%LOG%"
  exit /b 71
)
findstr /C:"[QAT-PQ] uploaded rank-1 codebook scratchpad/ws10/w10q_d_wkvcb_%STEPS%.txt" "%DIR%\probe_%STAMP%.log" >nul
if errorlevel 1 (
  echo %TAG% PROBE_DID_NOT_LOAD_THE_LEARNED_WKV_CATALOG %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_72 %DATE% %TIME% >> "%LOG%"
  exit /b 72
)
findstr /C:"[QAT-SHIFT-PQ] loaded scratchpad/ws10/w10q_d_shiftcb_%STEPS%.txt" "%DIR%\probe_%STAMP%.log" >nul
if errorlevel 1 (
  echo %TAG% PROBE_DID_NOT_LOAD_THE_LEARNED_SHIFT_CATALOG %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_73 %DATE% %TIME% >> "%LOG%"
  exit /b 73
)
findstr /C:"learnable=True" "%DIR%\probe_%STAMP%.log" >nul
if not errorlevel 1 (
  echo %TAG% PROBE_RAN_WITH_LEARNING_ON %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_74 %DATE% %TIME% >> "%LOG%"
  exit /b 74
)
.venv\Scripts\python.exe scratchpad/qat_tax/sanity_probe_gate.py %TAG%p --base w10plain >> "%LOG%" 2>&1
if not %ERRORLEVEL%==0 (
  echo %TAG% PROBE_OUT_OF_BAND %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_75 %DATE% %TIME% >> "%LOG%"
  exit /b 75
)
echo %TAG% PROBE_OK %TIME% >> "%LOG%"

REM ---- PHASE C: rectified VAL-half eval, users 5001-7500, quant-aware with the learned catalogs ----
.venv\Scripts\python.exe scratchpad/write_eval_toml.py scratchpad/w10qat w10q_d %DIR%\eval.toml RWKV-%TAG% RWKV-P-%TAG% 5001 7500 > "%DIR%\etoml_%STAMP%.log" 2>&1
if not %ERRORLEVEL%==0 (
  echo %TAG% ETOML_FAILED %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_76 %DATE% %TIME% >> "%LOG%"
  exit /b 76
)
findstr /C:"F:/rwkv_lmdb/test_db_5k_id5" "%DIR%\eval.toml" >nul
if errorlevel 1 (
  echo %TAG% EVAL_DB_MISMATCH %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_77 %DATE% %TIME% >> "%LOG%"
  exit /b 77
)
if exist "result\RWKV-%TAG%.jsonl" del /q "result\RWKV-%TAG%.jsonl"
if exist "result\RWKV-P-%TAG%.jsonl" del /q "result\RWKV-P-%TAG%.jsonl"
del /q scratchpad\eval_shards\shard_*.log 2>nul
.venv\Scripts\python.exe -u optimization/eval_sharded.py --config %DIR%\eval.toml --shards 1 --solo-threshold 0 --exclude 6701 --fetch-per-shard 2 --threads-per-shard 7 > "%DIR%\eval_%STAMP%.log" 2>&1
if not %ERRORLEVEL%==0 (
  echo %TAG% EVAL_FAILED %DATE% %TIME% >> "%LOG%"
  echo DONE_EXIT_78 %DATE% %TIME% >> "%LOG%"
  exit /b 78
)
REM Post-check on the SHARD logs, DELIBERATELY NON-FATAL: the probe above is the authoritative
REM check, and a guard that can destroy a finished 10 h eval on a string mismatch is worse than
REM the failure it guards against.
findstr /C:"w10q_d_wkvcb_%STEPS%.txt" scratchpad\eval_shards\shard_*.log >nul 2>&1
if errorlevel 1 (
  echo %TAG% NOTE the shard logs do not name the learned WKV catalog -- verify before trusting the number %DATE% %TIME% >> "%LOG%"
)
echo %TAG% EVAL_OK %TIME% >> "%LOG%"

REM ---- PHASE D: split the tax into its parts on users 5001-5300 (scratchpad/qat_decomp/PREREG.md) ----
REM Two more evals of THIS checkpoint, each the deploy env minus one quantizer, about 2.5 h. NEVER
REM FATAL: run_decomp.cmd logs to its own decomp.log and always returns, and the marker below is
REM written whatever it did. Added 2026-09-10 while the waiter was still polling, before any call.
echo %TAG% DECOMP start %TIME% >> "%LOG%"
call scratchpad\qat_decomp\run_decomp.cmd %TAG% %STEPS% w10q_d scratchpad/w10qat %DIR% %RWKV_QAT_PQ% %RWKV_QAT_SHIFT_PQ%
echo %TAG% DECOMP returned %ERRORLEVEL% %TIME% >> "%LOG%"

REM Terminal marker BEFORE endlocal: endlocal restores the pre-setlocal environment,
REM so %LOG% would expand to empty and the marker would go to "".
echo DONE_EXIT_0 %DATE% %TIME% >> "%LOG%"
endlocal & exit /b 0
