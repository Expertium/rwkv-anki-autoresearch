__pycache__/
*.pyc
*.pyo
*.pyd
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Vendored pretrained weights (large binaries; copy from ../srs-benchmark/pretrain)
pretrain/

# LMDB databases (huge; see lmdb-storage-plan memory)
*_db/
train_db/
test_db/
label_filter_db/
*.mdb

# Compiled CUDA/C++ extension build artifacts
build/
*.so
*.pyd
*.dll
*.egg-info/

# Scratch / local outputs
result/
raw/
evaluation/
wandb/
*.log

# Rust build artifacts (regenerable)
target/

# Reference port artifacts: large + regenerable (keep ref_metrics.json + weight_names.json)
reference/*.safetensors
reference/trace_user_*.json
reference/rust_pred_*.json
# reference_a18/ = the self-consistent track-2 parity trace (2026-07-26). Same rule: the bulk
# artifacts are regenerable via export_rnn_trace.py with RWKV_REF_DIR, so only ref_metrics.json
# (the small record of WHICH model+arch the trace belongs to) is tracked.
reference_a18/*.safetensors
reference_a18/trace_user_*.json
reference_a18/rust_pred_*.json
reference_a18/weight_names.json

# reference_realcyc/ = the GEN-5 lineage's certified parity trace (2026-09-07, PARITY: PASS on the
# 109-dim layout -- the first exercise of the engine's dynamic FEATURE_DIM on a real non-92 model).
# Same rule as reference/ and reference_a18/: only ref_metrics.json is tracked, the bulk is not.
reference_realcyc/trace_user_*.json
reference_realcyc/rust_pred_*.json
reference_realcyc/weight_names.json
preds_gen5/
# reference_final_inputs/ = final-layout INPUT traces for the w10lf line (2026-09-12, stand-in
# weights: never a parity reference). Only ref_metrics.json is tracked.
reference_final_inputs/rust_pred_*.json
reference_final_inputs/weight_names.json

# Model checkpoints (regenerable binaries; never track) + papers + any stray safetensors
*.pth
*.safetensors
*.pdf

# Large / transient scratch artifacts (regenerable): serialized tensors, compiled binaries,
# captured stdout logs, pre-tidy backups, and exported per-user reference traces. Keep the
# scripts + small configs in scratchpad/, drop these.
*.pt
*.exe
*.out
*.bak_pretidy
trace_user_*.json

# Mid-run learnable-codebook snapshots (one ~3.5 MB file per 500 steps per QAT run — 393 MiB
# of dead weight before 2026-07-15). Only the *final* codebooks matter (cb_wkv_final.txt /
# cb_shift_final.txt, referenced by champion_5k.json) and they don't match these patterns.
*_shiftcb_*.txt
*_wkvcb_*.txt

# Per-run exported codebooks: only the CURRENT QAT deploy-truth champion's are tracked
# (git add -f when a new QAT champion is promoted). Everything else stays untracked.
scratchpad/*/cb_shift_*.txt
scratchpad/*/cb_wkv_*.txt
!scratchpad/champ5k_b1/cb_shift_*.txt
!scratchpad/champ5k_b1/cb_wkv_*.txt
reference_iter31/*
!reference_iter31/ref_metrics.json
preds_iter31/

# reference_iter41/ = the INTERLEAVED champion's parity trace (2026-08-11), the first that
# certifies RWKV_INTERLEAVE + the _cnd stream order. Same rule as the other reference dirs:
# only ref_metrics.json is tracked, the bulk artifacts are single-machine and regenerable
# (RWKV_REF_DIR=reference_iter41 python export_rnn_trace.py with the champion env).
reference_iter41/*
!reference_iter41/ref_metrics.json
# Per-run engine prediction dumps + refactor regression outputs (regenerable in seconds).
preds_i41/
preds_i41c/
scratchpad/i31_regress/
scratchpad/i31_regress2/

# QAT shift-PQ corpora: ~250 MB of dumped fp32 token-shift vectors, regenerable in minutes from
# reference_iter45/ via `rwkv-infer --dump-shift-corpus`. One file exceeds GitHub's 100 MB limit.
scratchpad/qat_tax/corpus/
# ...and every per-checkpoint corpus the rank-1 floor check dumps (run_rank1_check.cmd
# writes corpus_<label>/). The bare `corpus/` line above did NOT match these and ~700 MB
# of state dumps reached a commit; the push bounced on GitHub's 100 MB file limit.
scratchpad/qat_tax/corpus_*/

# derived deck-tree artifact: rebuildable in ~4 min by scratchpad/deck_tree/build_parent_maps.py
scratchpad/deck_tree/parent_maps.parquet
scratchpad/deck_tree/*.log
# The parent map is TRACKED (4.6 MB): it is a RUN DEPENDENCY of any deck-tree iteration, so
# losing it would make a possible champion unreproducible. The null map is derived scratch.
scratchpad/deck_tree/parent_maps_null.parquet
scratchpad/deck_tree/smoke_out.txt

# --- Run diagnostics and scratch, 2026-08-16 housekeeping ---
# RWKV_GRAD_STATS dumps: ~6,200 lines each, one per ablation run, and NOT part of the
# scratchpad tracking convention (.cmd + tomls + *_ws_trace.jsonl). 14 of them were ~87k
# lines of the 110k unsynced diff.
**/*grad_stats*.json
*.bak
# Codebook FITS live in reference/ when they are a deploy artifact; the qat_tax working
# copies are regenerable scratch (81k lines for one file).
scratchpad/qat_tax/pq_cb_*.txt
scratchpad/fs_smoke.json
# Parity trace dirs: only ref_metrics.json is tracked, same rule as reference/.
reference_iter45/*
!reference_iter45/ref_metrics.json
scratchpad/deck_tree/smoke_out*.txt
scratchpad/reviewed_entity_counts_10k.csv
# Measured ALTERNATIVE codebooks (not the deploy choice) stay local -- regenerable by refit.
reference/pq_cb_shift_c80_m5b12.txt

# bug-hunt diagnostic runs: generated runners + tomls are tracked, artifacts are not
scratchpad/bughunt/diag_*/*.pth
scratchpad/bughunt/diag_*/*.log
scratchpad/bughunt/*.bak

# workload-efficiency replay: per-user intermediates are large and regenerable
scratchpad/workload/out/
scratchpad/workload/tables/
scratchpad/workload/logs/
scratchpad/workload/*.log

# Per-user delta dumps from the workload/hybrid analyses -- derived, ~10 MB each,
# regenerable from the result jsonls. Never useful to version.
scratchpad/hybrid100k/*.npz
scratchpad/fsrs7/out_*/
scratchpad/fsrs7/*.npz
scratchpad/qat_gen5/*.txt
scratchpad/qat_gen5/*.log

# the rented box: address + instance ids stay local
scratchpad/cloud/BOX.local.md

# The cum_new_cards side table (scratchpad/newcards): 283 MB flat + 102 MB npz, DERIVED and
# regenerable in ~1 minute from the read-only -id dataset by build_first_ths.py + flatten_first_ths.py.
# ⚠ I committed these on 2026-09-20 before noticing the size; the blobs are still in local history.
scratchpad/newcards/first_ths.npz
scratchpad/newcards/first_ths_flat.npy
scratchpad/newcards/first_ths_index.npz

# Per-ROW side tables (scratchpad/rowtables): GIGABYTES, derived, rebuilt by build_rowtables.py.
# Ignored BEFORE the first one is written -- see the note above for why that order matters.
scratchpad/rowtables/*.npy
scratchpad/rowtables/*.npz
scratchpad/rowtables/*.out
scratchpad/rowtables/*.err
# The phase-coherence figure's inputs are read-only dataset scans; the PNG is small and is tracked.
scratchpad/phase_coherence/scan.out
scratchpad/phase_coherence/scan.err
scratchpad/phase_coherence/plot.out
scratchpad/phase_coherence/plot.err

# ⚠ PQ CATALOG CORPORA ARE BULK SCRATCH, NOT RECORD (2026-09-22). A card corpus file is ~33 MB and
# a wide dump is 160 files / 3.1 GB. `scratchpad/qat_tax/corpus*` was ignored above; the lfqat ones
# were NOT, so `scratchpad/lfqat/corpus/` (12 files) and `corpus_wide/` (160) are already in local
# history and `.git` reached 3.9 GB. They are REDUMPABLE in ~40 min from a checkpoint + the trace
# exporter; what belongs in git is the fitted CATALOG (a few MB) and the runner that dumps them.
scratchpad/lfqat/corpus/
scratchpad/lfqat/corpus_wide/
scratchpad/lfqat/corpus_real/
scratchpad/lfqat/fit_files_no156.txt
# throwaway held-out validation catalogs (run_honest_rvq5.cmd); the DEPLOY catalogs in reference/
